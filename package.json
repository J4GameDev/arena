{
  "name": "farther",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check && npm test",
    "prepare": "git config core.hooksPath .githooks || true",
    "fight": "node scripts/fight.ts",
    "balance": "node scripts/balance.ts",
    "outliers": "node scripts/outliers.ts",
    "hunts": "node scripts/hunts.ts"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
